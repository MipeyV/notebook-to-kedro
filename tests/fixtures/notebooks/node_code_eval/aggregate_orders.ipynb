   "source": [
    "# Customer order totals"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aggregation-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "summary = transactions.groupby(\"customer_id\", as_index=False, sort=True).agg(\n",
    "    total_amount=(\"amount\", \"sum\"), order_count=(\"amount\", \"size\")\n",
    ")\n",
    "summary = summary.astype({\"customer_id\": \"object\"})"
   ]
  }
